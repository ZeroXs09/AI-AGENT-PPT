# ==============================================================================
# FlyPtx Environment Configuration
# ==============================================================================

# Application port (default: 3000)
PORT=3000

# Google Gemini API Key (Required for live AI presentation structuring)
# Get your free/paid key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Pexels API Key (Optional - for high-resolution stock photography)
# Get a free API key at: https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here

# Pixabay API Key (Optional - alternative stock photo provider)
# Get a free API key at: https://pixabay.com/api/docs/
PIXABAY_API_KEY=your_pixabay_api_key_here
